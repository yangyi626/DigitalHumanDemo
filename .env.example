# 必填：Boson/Higgs 语音服务 Key 和 DeepSeek 模型 Key。
BOSON_API_KEY=
DEEPSEEK_API_KEY=

# 以下均可保持默认。default 音色不需要原部署账户的专属 Voice ID。
BOSON_VOICE=default
HOST=127.0.0.1
PORT=8789
SESSION_SECONDS=300
MAX_SESSIONS=16
DEEPSEEK_MODEL=deepseek-flash
VOICE_ASR_PROVIDER=higgs

# 可选：固定访客 Cookie 签名密钥。留空时启动自动生成。
SESSION_SIGNING_KEY=
