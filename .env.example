# 必填：Boson/Higgs 语音服务 Key 和 DeepSeek 模型 Key。
BOSON_API_KEY=
DEEPSEEK_API_KEY=

# 以下均可保持默认。expert 自动准备随仓库提供的专家音色。
# 也可设置自己已有的 Voice ID；设为 default 时使用服务的通用音色。
BOSON_VOICE=expert
HOST=127.0.0.1
PORT=8789
SESSION_SECONDS=300
MAX_SESSIONS=16
DEEPSEEK_MODEL=deepseek-flash
VOICE_ASR_PROVIDER=higgs

# 可选：固定访客 Cookie 签名密钥。留空时启动自动生成。
SESSION_SIGNING_KEY=
